# Environment Variables Template
# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# AWS Configuration
AWS_PROFILE=personal
# AWS_REGION=us-east-1

# FRED API (for historical macro data backfill)
# Get a free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Broker Configuration
# Allowed values: simulated (default), alpaca_paper, alpaca_live
# BROKER_MODE=simulated

# Kill switch: must be explicitly set to 'true' for non-simulated modes
# BROKER_TRADING_ENABLED=false

# Alpaca Paper Trading (set via Secrets Manager for Lambda, or env for local)
# ALPACA_PAPER_KEY_ID=your_paper_key_id
# ALPACA_PAPER_SECRET_KEY=your_paper_secret_key

# Alpaca Live Trading (do not enable until paper validation is complete)
# ALPACA_LIVE_KEY_ID=your_live_key_id
# ALPACA_LIVE_SECRET_KEY=your_live_secret_key
